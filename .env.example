# Copia questo file in ".env" per lo sviluppo locale (netlify dev) e compila
# i valori reali. Su Netlify vanno invece impostate in:
# Site settings -> Environment variables.
# NON committare mai il file ".env" con i valori reali (già escluso da .gitignore).

# --- Stripe (create-checkout-session.cjs, google-pay-charge.cjs, stripe-webhook.cjs) ---
# Chiave segreta Stripe (Dashboard -> Sviluppatori -> Chiavi API). sk_test_... in sviluppo, sk_live_... in produzione.
STRIPE_SECRET_KEY=

# Chiave pubblicabile Stripe, usata lato client (Google Pay). pk_test_... o pk_live_..., deve corrispondere allo stesso ambiente di STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=

# Signing secret del webhook Stripe (Dashboard -> Developers -> Webhooks -> il tuo endpoint). Necessario solo se usi stripe-webhook.cjs.
STRIPE_WEBHOOK_SECRET=

# --- PayPal (paypal-create-order.cjs, paypal-capture-order.cjs, lib/paypal-client.cjs) ---
# Client ID PayPal, usato sia lato client (bottone) sia lato server per ottenere il token OAuth.
VITE_PAYPAL_CLIENT_ID=

# Client Secret PayPal — mai esposto al browser.
PAYPAL_CLIENT_SECRET=

# URL base dell'API PayPal. Lascia vuoto per usare la produzione (default: https://api.paypal.com).
# In sviluppo/test imposta: https://api-m.sandbox.paypal.com
PAYPAL_API_BASE_URL=

# --- Netlify Blobs (lib/stock.cjs, lib/order-id.cjs, lib/orders-store.cjs, lib/pending-paypal-items.cjs) ---
# Su questo sito Netlify non inietta automaticamente le credenziali Blobs nelle
# function: vanno passate esplicitamente. Le trovi in Netlify -> Site
# configuration -> General -> Site details (Site ID) e in User settings -> Applications -> Personal access tokens.
BLOBS_SITE_ID=
BLOBS_TOKEN=

# --- Brevo (subscribe-newsletter.cjs, lib/stock-alert.cjs) ---
# Chiave API Brevo (Brevo -> SMTP & API -> API Keys). Usata sia per iscrivere alla newsletter sia per l'alert scorte esaurite.
BREVO_API_KEY=

# Indirizzo mittente per l'email di alert scorte esaurite. DEVE essere un'email verificata su Brevo (Settings -> Senders & IP -> Senders).
BREVO_SENDER_EMAIL=

# Indirizzo del venditore che riceve l'alert quando le scorte finiscono a metà ordine.
SELLER_ALERT_EMAIL=
